# ─── Required ─────────────────────────────────────────────────
# Claude API key — powers commit analysis, runbook synthesis,
# impact reasoning, and postmortem drafting.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Optional: Claude model overrides ─────────────────────────
# Reasoning stages default to claude-opus-4-8; lightweight steps
# (query rewriting, formatting) default to claude-haiku-4-5.
# Uncomment to override either.
# CLAUDE_MODEL_REASONING=claude-opus-4-8
# CLAUDE_MODEL_FAST=claude-haiku-4-5

# ─── Slack ────────────────────────────────────────────────────
# Slack incoming webhook. If unset, briefs print Block Kit JSON to stdout.
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ─── Git repository under investigation ───────────────────────
# Path to the repo the commit analyzer runs `git log` / `git diff` against.
# Defaults to the demo Flask service shipped with this project.
DEMO_GIT_REPO_PATH=./demo/app

# ─── Embeddings for runbook RAG ───────────────────────────────
# Preferred: Voyage AI — Anthropic's recommended embedding partner.
# Sign up at https://www.voyageai.com/ and paste the key here.
# If unset, IncidentLens falls back to a local sentence-transformers model
# (all-MiniLM-L6-v2, ~90MB, downloads on first use).
VOYAGE_API_KEY=

# ─── Metrics source ───────────────────────────────────────────
# Optional Prometheus HTTP API. If unset, the impact estimator uses a
# built-in mock metrics store that generates realistic incident-window data.
# Example: http://localhost:9090
PROMETHEUS_URL=

# ─── Logging ──────────────────────────────────────────────────
# Root log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
